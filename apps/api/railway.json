{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": [
      "apps/api/**",
      "packages/api-contract/**",
      "packages/db/**",
      "packages/env/**",
      "packages/shared/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "turbo.json",
      ".dockerignore"
    ]
  },
  "deploy": {
    "startCommand": "bun apps/api/src/main.ts",
    "preDeployCommand": ["bun --cwd packages/db src/migrate.ts"],
    "healthcheckPath": "/healthz"
  }
}
