{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "start": "node dist/main.js"
  },
  "exports": {
    "./app": "./src/app.ts"
  },
  "tsup": {
    "entry": [
      "src/main.ts"
    ],
    "format": [
      "esm"
    ],
    "target": "node22",
    "platform": "node",
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "dts": false
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@hono/zod-openapi": "^0.19.10",
    "@hono/zod-validator": "^0.7.6",
    "@workspace/api-contract": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/shared": "workspace:^",
    "bcrypt": "^6.0.0",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "jsonwebtoken": "^9.0.3",
    "yahoo-finance2": "^3.14.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@swc/core": "^1.15.21",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.1.0",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^12.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.2"
  }
}
