{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --hot src/main.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env.test test",
    "test:watch": "bun --env-file=../../.env.test test --watch",
    "start": "bun src/main.ts"
  },
  "exports": {
    "./app": "./src/app.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@workspace/api-contract": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/shared": "workspace:^",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "jsonwebtoken": "^9.0.3",
    "yahoo-finance2": "^3.14.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/bun": "^1.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0"
  }
}
