{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --hot src/main.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env.test test",
    "test:watch": "bun --env-file=../../.env.test test --watch",
    "start": "bun src/main.ts"
  },
  "exports": {
    "./app": "./src/app.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.10",
    "@hono/zod-validator": "^0.9.1",
    "@workspace/api-contract": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/shared": "workspace:^",
    "better-auth": "1.7.10",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "yahoo-finance2": "^4.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
