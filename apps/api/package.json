    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/schedule": "^6.1.1",
    "@ts-rest/core": "^3.51.0",
    "@ts-rest/nest": "^3.52.1",
    "@workspace/api-contract": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/shared": "workspace:^",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
