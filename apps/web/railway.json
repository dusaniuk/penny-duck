{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/web/Dockerfile",
    "watchPatterns": [
      "apps/web/**",
      "packages/api-contract/**",
      "packages/shared/**",
      "packages/ui/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "turbo.json",
      ".dockerignore"
    ]
  },
  "deploy": {
    "startCommand": "bun .output/server/index.mjs"
  }
}
