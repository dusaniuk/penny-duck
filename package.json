{
  "name": "penny-duck",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:push": "pnpm --filter @workspace/db db:push",
    "db:generate": "pnpm --filter @workspace/db db:generate",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "db:deploy": "pnpm --filter @workspace/db db:deploy",
    "db:studio": "pnpm --filter @workspace/db db:studio",
    "build": "turbo build",
    "build:web": "pnpm --filter web... build",
    "start:api": "bun apps/api/src/main.ts",
    "start:web": "bun run apps/web/.output/server/index.mjs",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test:e2e": "pnpm --filter e2e test",
    "test:e2e:api": "pnpm --filter e2e test:api",
    "test:e2e:ui": "pnpm --filter e2e test:ui",
    "test:unit": "pnpm --filter api test",
    "test": "pnpm test:unit && pnpm test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.9",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20"
  }
}
