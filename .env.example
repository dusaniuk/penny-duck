# The same variables as in production; only the values differ.

# Database: the local Postgres from docker-compose.yml. Written out in full,
# since drizzle-kit reads .env without ${...} expansion.
DATABASE_URL=postgresql://penny:duck@localhost:5433/penny_duck

# Web: where the /api proxy and SSR auth check reach the API (read at runtime)
API_URL=http://localhost:3030

# Auth
# Min 32 chars, generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_URL=http://localhost:3000