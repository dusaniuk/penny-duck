{
  "name": "@workspace/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup"
  },
  "tsup": {
    "entry": ["src/currencies.ts"],
    "format": ["esm"],
    "dts": true,
    "sourcemap": true
  },
  "exports": {
    "./currencies": {
      "node": "./dist/currencies.js",
      "default": "./src/currencies.ts"
    }
  }
}
