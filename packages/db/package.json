{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "node dist/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\""
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/migrate.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": false,
    "sourcemap": true
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./*": {
      "node": "./dist/*.js",
      "default": "./src/*.ts"
    }
  }
}
