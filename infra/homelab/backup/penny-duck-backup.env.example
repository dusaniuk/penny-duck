# Copy to /etc/penny-duck/backup.env (owned by root, mode 600).

DB_CONTAINER=
DB_USER=postgres
DB_NAME=postgres

AGE_RECIPIENT=age1...

# rclone remote "b2", defined here instead of in an rclone.conf
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
RCLONE_REMOTE=b2:penny-duck-backups

HEALTHCHECK_URL=
